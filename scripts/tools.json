{
  "gh": {
    "profiles": ["host", "box"],
    "install": {
      "linux": [
        ["bash", "-c", "set -eo pipefail; mkdir -p \"{bin}\"; v=$(basename $(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/cli/cli/releases/latest)); v=${v#v}; curl -fsSL \"https://github.com/cli/cli/releases/download/v$v/gh_${v}_linux_{cpu}.tar.gz\" | tar -xzO \"gh_${v}_linux_{cpu}/bin/gh\" > \"{bin}/gh\"; chmod +x \"{bin}/gh\""]
      ],
      "darwin": [
        ["brew", "install", "gh"]
      ],
      "win32": [
        ["winget", "install", "--id", "GitHub.cli", "--exact", "--silent", "--accept-package-agreements", "--accept-source-agreements"]
      ]
    }
  },
  "glab": {
    "profiles": ["host"],
    "install": {
      "linux": [
        ["bash", "-c", "set -eo pipefail; mkdir -p \"{bin}\"; v=$(curl -fsSL https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases/permalink/latest | grep -o '\"tag_name\":\"[^\"]*\"' | cut -d'\"' -f4); v=${v#v}; curl -fsSL \"https://gitlab.com/gitlab-org/cli/-/releases/v$v/downloads/glab_${v}_linux_{cpu}.tar.gz\" | tar -xzO \"bin/glab\" > \"{bin}/glab\"; chmod +x \"{bin}/glab\""]
      ],
      "darwin": [
        ["brew", "install", "glab"]
      ],
      "win32": [
        ["winget", "install", "--id", "GLab.GLab", "--exact", "--silent", "--accept-package-agreements", "--accept-source-agreements"]
      ]
    }
  },
  "acli": {
    "profiles": ["host"],
    "install": {
      "linux": [
        ["curl", "-fsSL", "--create-dirs", "-o", "{bin}/acli", "https://acli.atlassian.com/linux/latest/acli_linux_{cpu}/acli"],
        ["chmod", "+x", "{bin}/acli"]
      ],
      "darwin": [
        ["brew", "tap", "atlassian/homebrew-acli"],
        ["brew", "install", "acli"]
      ],
      "win32": [
        ["curl.exe", "-fsSL", "--create-dirs", "-o", "{bin}\\acli.exe", "https://acli.atlassian.com/windows/latest/acli_windows_amd64/acli.exe"]
      ]
    }
  },
  "claude": {
    "profiles": ["host"],
    "install": {
      "linux": [
        ["bash", "-c", "curl -fsSL https://claude.ai/install.sh | bash"]
      ],
      "darwin": [
        ["bash", "-c", "curl -fsSL https://claude.ai/install.sh | bash"]
      ],
      "win32": [
        ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "irm https://claude.ai/install.ps1 | iex"]
      ]
    }
  },
  "codex": {
    "profiles": ["host"],
    "install": {
      "linux": [
        ["npm", "install", "--global", "--prefix", "{home}/.local", "@openai/codex"]
      ],
      "darwin": [
        ["npm", "install", "--global", "--prefix", "{home}/.local", "@openai/codex"]
      ],
      "win32": [
        ["npm", "install", "--global", "@openai/codex"]
      ]
    }
  },
  "sbx": {
    "profiles": ["server"],
    "check": ["version"],
    "install": {
      "linux": [
        ["bash", "-c", "curl -fsSL https://get.docker.com | sudo REPO_ONLY=1 sh"],
        ["sudo", "apt-get", "install", "-y", "docker-sbx"]
      ]
    }
  },
  "tailscale": {
    "profiles": ["server"],
    "install": {
      "linux": [
        ["bash", "-c", "curl -fsSL https://tailscale.com/install.sh | sh"]
      ]
    }
  }
}
